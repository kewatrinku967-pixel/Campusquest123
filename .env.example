# Public Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server only: never expose this in browser code
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Competition configuration
NEXT_PUBLIC_GAME_NAME=Campus Quest
NEXT_PUBLIC_PRICE_PER_PLAYER=30
NEXT_PUBLIC_TEAM_MIN_SIZE=2
NEXT_PUBLIC_TEAM_MAX_SIZE=4
GAME_DURATION_SECONDS=1800
HINT_PENALTY_SECONDS=120

# Payment details displayed to users
UPI_ID=your-upi-id@bank
UPI_PAYEE_NAME=Campus Quest Organisers

# Optional: private Supabase Storage bucket
PAYMENT_PROOFS_BUCKET=payment-proofs
